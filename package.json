{
  "name": "supermarket-pro-billing",
  "version": "1.0.0",
  "description": "SuperMarket Pro - Shop Billing & Inventory System",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:start": "npm run build && electron .",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --x64",
    "build:win": "npm run build && electron-builder --win",
    "build:win:portable": "npm run build && electron-builder --win portable"
  },
  "keywords": ["billing", "pos", "inventory", "shop", "thermal-printer", "barcode"],
  "author": "Your Shop Name",
  "license": "MIT",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "vite": "^5.2.0"
  },
  "build": {
    "appId": "com.yourshop.supermarketpro",
    "productName": "SuperMarket Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SuperMarket Pro"
    }
  }
}
